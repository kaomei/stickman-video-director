[
  {
    "start": 0.065,
    "end": 0.745,
    "text": "This guy"
  },
  {
    "start": 0.745,
    "end": 2.405,
    "text": "refused a free breakfast."
  },
  {
    "start": 2.405,
    "end": 3.605,
    "text": "His friend was paying."
  },
  {
    "start": 3.605,
    "end": 4.345,
    "text": "No catch."
  },
  {
    "start": 4.345,
    "end": 6.625,
    "text": "Just one very, very fragile ego."
  },
  {
    "start": 6.625,
    "end": 8.335,
    "text": "His friend even offered a bun."
  },
  {
    "start": 8.335,
    "end": 9.025,
    "text": "Still no."
  },
  {
    "start": 9.025,
    "end": 10.535,
    "text": "This started at the arcade."
  },
  {
    "start": 10.535,
    "end": 11.17,
    "text": "He lost."
  },
  {
    "start": 11.915,
    "end": 12.705,
    "text": "Lost again."
  },
  {
    "start": 12.705,
    "end": 13.865,
    "text": "Then took it personally."
  },
  {
    "start": 13.865,
    "end": 14.705,
    "text": "Now he won't eat"
  },
  {
    "start": 14.705,
    "end": 16.535,
    "text": "until his friend finally loses."
  },
  {
    "start": 16.535,
    "end": 17.855,
    "text": "So the bun's getting cold."
  },
  {
    "start": 17.855,
    "end": 18.705,
    "text": "And his ego?"
  },
  {
    "start": 18.705,
    "end": 19.99,
    "text": "Still needs another rematch."
  }
]
